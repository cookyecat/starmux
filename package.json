{
  "name": "mac-mcp-gateway",
  "version": "0.9.0",
  "description": "Self-hosted Mac MCP Gateway for remote AI clients and Desktop Commander MCP tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "mac-mcp-gateway": "bin/mac-mcp-gateway.mjs"
  },
  "scripts": {
    "setup": "node bin/setup-wizard.mjs",
    "doctor:setup": "node bin/mac-mcp-gateway.mjs doctor-setup",
    "start:setup": "node bin/mac-mcp-gateway.mjs run --profile setup",
    "verify:setup": "node bin/verify-setup.mjs",
    "status": "node bin/mac-mcp-gateway.mjs status",
    "remote:revoke": "node bin/community-remote-revoke.mjs",
    "test": "npm run build && node dist/test/run.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build",
    "test:oauth:keycloak": "npm run build && node --test dist/test/keycloak.integration.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@wonderwhy-er/desktop-commander": "0.3.0",
    "jose": "6.2.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/src",
    "bin/*.mjs",
    "src/dc-workspace-http.mjs",
    "scripts/prepare.mjs",
    "test/fixtures/p1-fixture.txt",
    "LICENSE",
    "README.md",
    "docs/ACCESS_CONTROL.md",
    "docs/OAUTH.md",
    "docs/REMOTE_SETUP.md",
    "docs/INSTALL.md",
    "docs/CONNECT_CHATGPT.md",
    "docs/PLATFORMS.md",
    "docs/VALIDATION_WORKBUDDY.md",
    "docs/VALIDATION_TUNNEL.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/README.md",
    "docs/CLIENTS.md",
    "docs/SECURITY.md",
    "docs/RELEASE_STATUS.md",
    "docs/ARCHITECTURE.md",
    "docs/assets/mcp-gateway-simple.svg",
    "docs/assets/mac-mcp-gateway-menu-en.png"
  ]
}
